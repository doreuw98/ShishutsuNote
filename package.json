{
  "name": "smart-expense-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node --use-system-ca ./node_modules/vite/bin/vite.js preview",
    "start": "node --use-system-ca server.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
