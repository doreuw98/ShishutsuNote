{
  "name": "smart-expense-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node --use-system-ca ./node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc -b --pretty false",
    "worker:dev": "node --use-system-ca ./node_modules/wrangler/bin/wrangler.js dev",
    "db:local:migrate": "wrangler d1 migrations apply shishutsu-note-db --local",
    "db:remote:migrate": "wrangler d1 migrations apply shishutsu-note-db --remote",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
